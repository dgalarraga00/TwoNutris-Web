generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

// ─── Modelos ─────────────────────────────────────────────────────

/// Enlazado 1:1 con auth.users de Supabase
model Profile {
  id        String   @id @db.Uuid
  fullName  String?  @map("full_name")
  whatsapp  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@map("profiles")
}

/// Pedido finalizado — inmutable
model Order {
  id                    String      @id @default(uuid()) @db.Uuid
  profileId             String      @map("profile_id") @db.Uuid
  status                OrderStatus @default(PENDING)
  total                 Float
  deliveryAddress       String      @map("delivery_address")
  deliveryInstructions  String?     @map("delivery_instructions")
  payphoneTransactionId String?     @map("payphone_transaction_id")
  deliveryDate          DateTime?   @map("delivery_date")
  deliverySlot          String?     @map("delivery_slot") // "MORNING" | "AFTERNOON"
  taxIdType             String      @map("tax_id_type")
  taxId                 String      @map("tax_id")
  customerEmail         String?     @map("customer_email")
  invoiceNumber         Int         @default(autoincrement()) @map("invoice_number")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  profile Profile     @relation(fields: [profileId], references: [id])
  items   OrderItem[]

  @@index([createdAt]) // filtro por fecha + orden por defecto en el panel admin
  @@index([profileId]) // historial de pedidos por cliente (las FK no indexan solas en Postgres)
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  dishId    String   @map("dish_id")
  dishName  String   @map("dish_name")
  quantity  Int
  unitPrice Float    @map("unit_price")
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

enum DishTemplateCategory {
  CLASICO
  VEGETARIANO
  PREMIUM
}

enum WeeklyMenuStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model DishTemplate {
  id           String               @id @default(uuid()) @db.Uuid
  name         String
  description  String
  image        String?
  category     DishTemplateCategory
  price        Float                @default(6.75)
  calories     Int?
  protein      Float?
  carbs        Float?
  fat          Float?
  ingredients  String?
  allergens    String[]             @default([])
  servingSize  Float?               @map("serving_size")
  servingUnit  String?              @map("serving_unit")
  fatSaturated Float?               @map("fat_saturated")
  fatTrans     Float?               @map("fat_trans")
  cholesterol  Float?
  sodium       Float?
  fiber        Float?
  sugarTotal   Float?               @map("sugar_total")
  sugarAdded   Float?               @map("sugar_added")
  isActive     Boolean              @default(true) @map("is_active")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  weeklyMenuItems WeeklyMenuItem[]

  @@map("dish_templates")
}

model WeeklyMenu {
  id        String           @id @default(uuid()) @db.Uuid
  weekStart DateTime         @map("week_start")
  weekEnd   DateTime         @map("week_end")
  status    WeeklyMenuStatus @default(DRAFT)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  items WeeklyMenuItem[]

  @@map("weekly_menus")
}

model WeeklyMenuItem {
  id       String @id @default(uuid()) @db.Uuid
  menuId   String @map("menu_id") @db.Uuid
  dishId   String @map("dish_id") @db.Uuid
  position Int    @default(0)

  menu WeeklyMenu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  dish DishTemplate @relation(fields: [dishId], references: [id])

  @@unique([menuId, dishId])
  @@map("weekly_menu_items")
}
